[Unit]
Description=Paradivine scheduled job %i
After=paradivine.service
Requires=paradivine.service

[Service]
Type=oneshot
User=paradivine
Group=paradivine
ExecStart=/usr/local/bin/node /usr/local/lib/paradivine/cron-request.mjs %i
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0027
