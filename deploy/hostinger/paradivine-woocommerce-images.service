[Unit]
Description=Import WooCommerce product images
After=paradivine.service
Requires=paradivine.service

[Service]
Type=oneshot
User=paradivine
Group=paradivine
ExecStart=/usr/local/bin/node /usr/local/lib/paradivine/woocommerce-images.mjs
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0027
