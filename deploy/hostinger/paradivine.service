[Unit]
Description=Paradivine Next.js storefront
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paradivine
Group=paradivine
WorkingDirectory=/srv/paradivine/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=1536
Environment=MALLOC_ARENA_MAX=2
# Disable the Vercel-only lazy scheduler. Dedicated timers own scheduled work.
Environment=VERCEL_ENV=preview
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
