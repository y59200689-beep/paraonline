    "test:e2e:a11y": "playwright test tests/e2e/public-quality.spec.ts",
    "test:e2e:smoke": "playwright test tests/e2e/commerce-smoke.spec.ts",
    "test:e2e:baseline": "playwright test tests/e2e/baseline-captures.spec.ts --project=baseline"
    ,"test:e2e:private": "playwright test tests/e2e/private-product-smoke.spec.ts"
    ,"test:e2e:private:baseline": "playwright test tests/e2e/private-product-baseline.spec.ts --project=baseline"
  },
  "dependencies": {
