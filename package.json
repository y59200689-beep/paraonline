    "@types/node": "^20.19.43",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
